{{ define "split_inputs_.gotpl" }}
{{ reserveImport "fmt" }}
{{- range $inputName := .Ownership.InputOwnerKeys }}
{{- if eq (index $.Ownership.InputOwner $inputName) $.ShardName }}
{{- with $input := index $.InputByName $inputName }}
{{- if not $input.HasUnmarshal }}
{{- $it := "it" }}
{{- if $input.PointersInUnmarshalInput }}
  {{- $it = "&it" }}
{{- end }}
{{- /* Hybrid inputs (Go type has UnmarshalGQLContext): the schema's field
       directives and defaults are applied at runtime by
       shardruntime.ApplyInputDirectives, the method then decodes the fields,
       and shardruntime.ApplyInputFieldResolvers runs the field resolvers on the
       decoded value; both recurse into nested hybrid inputs. Only nested inputs
       the runtime cannot reach keep a generated case arm. See
       Object.HybridGeneratedFields and Object.HybridResolverFields. The
       monolithic layout (codegen/input.gotpl) keeps an arm per directive-bearing
       field instead. */}}
{{- $hybrid := $input.HasContextUnmarshal }}
{{- $switchFields := $input.Fields }}
{{- $resolverFields := false }}
{{- if $hybrid }}
{{- $switchFields = $input.HybridGeneratedFields }}
{{- $resolverFields = $input.HybridResolverFields }}
{{- end }}

// split_inputs_.gotpl
func __splitInput_{{ $input.Name }}(ctx context.Context, ec shardruntime.ObjectExecutionContext, obj any) ({{ if $input.PointersInUnmarshalInput }}*{{ end }}{{ $input.Type | ref }}, error) {
	{{- if not $input.IsMap }}
	// If already unmarshaled to the correct type, return directly.
	if typed, ok := obj.({{ $input.Type | ref }}); ok {
		return {{ if $input.PointersInUnmarshalInput }}&{{ end }}typed, nil
	}
	if typed, ok := obj.(*{{ $input.Type | ref }}); ok {
		{{- if $input.PointersInUnmarshalInput }}
		return typed, nil
		{{- else }}
		if typed == nil {
			var zero {{ $input.Type | ref }}
			return zero, nil
		}
		return *typed, nil
		{{- end }}
	}
	{{- end }}
	{{- if $input.IsMap }}
	it := map[string]any{}
	{{- else }}
	var it {{ $input.Type | ref }}
	{{- end }}
	if obj == nil {
		return {{ $it }}, nil
	}
	asMap := map[string]any{}
	rawMap, ok := obj.(map[string]any)
	if !ok {
		return {{ $it }}, fmt.Errorf("unmarshalInput{{ $input.Name }}: expected map[string]any, got %T", obj)
	}
	for k, v := range rawMap {
		asMap[k] = v
	}
	{{ range $field := $input.Fields }}
		{{- if notNil "Default" $field }}
			if _, present := asMap[{{ $field.Name | quote }}]; !present {
				asMap[{{ $field.Name | quote }}] = {{ $field.Default | dump }}
			}
		{{- end }}
	{{- end }}

	{{- if $hybrid }}
	if err := shardruntime.ApplyInputDirectives(ctx, ec, splitScope, {{ $input.Name | quote }}, obj, asMap); err != nil {
		return {{ $it }}, err
	}
	{{- $methodInput := "asMap" }}
	{{- if $switchFields }}

	plain := make(map[string]any, len(asMap))
	for k, v := range asMap {
		switch k {
		case {{ range $i, $field := $switchFields }}{{ if $i }}, {{ end }}{{ $field.Name | quote }}{{ end }}:
		default:
			plain[k] = v
		}
	}
	{{- $methodInput = "plain" }}
	{{- end }}
	{{- if $resolverFields }}
	{{- $methodInput = printf "shardruntime.StripInputResolverFields(splitScope, %q, %s)" $input.Name $methodInput }}
	{{- end }}

	if err := it.UnmarshalGQLContext(ctx, {{ $methodInput }}); err != nil {
		return {{ $it }}, err
	}
	{{- end }}
	{{- if or (not $hybrid) $switchFields }}

	fieldsInOrder := [...]string{ {{ range $switchFields }}{{ quote .Name }},{{ end }} }
	for _, k := range fieldsInOrder {
		v, ok := asMap[k]
		if !ok {
			continue
		}
		switch k {
		{{- range $field := $switchFields }}
		case {{ $field.Name | quote }}:
			{{- $lhs := (printf "it.%s" $field.GoFieldName) }}
			{{- if $input.IsMap }}
				{{- $lhs = (printf "it[%q]" $field.Name) }}
			{{- end }}
			ctx := graphql.WithPathContext(ctx, graphql.NewPathWithField({{ $field.Name | quote }}))
			{{- if $field.ImplDirectives }}
			{{- /* INPUT_FIELD_DEFINITION directives, mirroring codegen/input.gotpl. */}}
			directive0 := func(ctx context.Context) (any, error) {
				return ec.UnmarshalCodec(ctx, {{ $field.TypeReference.UnmarshalFunc | quote }}, v)
			}
			{{- range $i, $directive := $field.ImplDirectives }}
			directive{{ add $i 1 }} := func(ctx context.Context) (any, error) {
				return ec.InvokeDirective(ctx, {{ $directive.Name | quote }}, {{ $field.DirectiveObjName }}, directive{{ $i }}, {{ template "splitDirectiveArgs" $directive }})
			}
			{{- end }}
			tmp, err := directive{{ len $field.ImplDirectives }}(ctx)
			if err != nil {
				return {{ $it }}, graphql.ErrorOnPath(ctx, err)
			}
			if data, ok := tmp.({{ $field.TypeReference.GO | ref }}); ok {
				{{- if $field.IsResolver }}
				if _, err := ec.InvokeResolver(ctx, {{ $input.Name | quote }}, {{ $field.Name | quote }}, []any{&it, data}); err != nil {
					return {{ $it }}, err
				}
				{{- else }}
				{{- if $field.TypeReference.IsOmittable }}
				{{ $lhs }} = graphql.OmittableOf(data)
				{{- else }}
				{{ $lhs }} = data
				{{- end }}
				{{- end }}
			{{- if $field.TypeReference.IsNilable }}
			{{- if not $field.IsResolver }}
			} else if tmp == nil {
				{{- if $field.TypeReference.IsOmittable }}
				{{ $lhs }} = graphql.OmittableOf[{{ $field.TypeReference.GO | ref }}](nil)
				{{- else }}
				{{ $lhs }} = nil
				{{- end }}
			{{- end }}
			{{- end }}
			} else {
				err := fmt.Errorf(`unexpected type %T from directive, should be {{ $field.TypeReference.GO }}`, tmp)
				return {{ $it }}, graphql.ErrorOnPath(ctx, err)
			}
			{{- else }}
			data, err := ec.UnmarshalCodec(ctx, {{ $field.TypeReference.UnmarshalFunc | quote }}, v)
			if err != nil {
				return {{ $it }}, err
			}
			{{- if $field.IsResolver }}
			if _, err := ec.InvokeResolver(ctx, {{ $input.Name | quote }}, {{ $field.Name | quote }}, []any{&it, data}); err != nil {
				return {{ $it }}, err
			}
			{{- else }}
			{{- if $field.TypeReference.IsNilable }}
			if data != nil {
				{{- if $field.TypeReference.IsOmittable }}
				{{ $lhs }} = graphql.OmittableOf(data.({{ $field.TypeReference.GO | ref }}))
				{{- else }}
				{{ $lhs }} = data.({{ $field.TypeReference.GO | ref }})
				{{- end }}
			{{- if $field.TypeReference.IsOmittable }}
			} else {
				{{ $lhs }} = graphql.OmittableOf[{{ $field.TypeReference.GO | ref }}](nil)
			}
			{{- else }}
			}
			{{- end }}
			{{- else }}
				{{- if $field.TypeReference.IsOmittable }}
			{{ $lhs }} = graphql.OmittableOf(data.({{ $field.TypeReference.GO | ref }}))
				{{- else }}
			{{ $lhs }} = data.({{ $field.TypeReference.GO | ref }})
				{{- end }}
			{{- end }}
			{{- end }}
			{{- end }}
		{{- end }}
		}
	}
	{{- end }}
	{{- if $resolverFields }}

	if err := shardruntime.ApplyInputFieldResolvers(ctx, ec, splitScope, {{ $input.Name | quote }}, &it, asMap); err != nil {
		return {{ $it }}, err
	}
	{{- end }}

	{{- if $input.InputObjectDirectives }}
	{{- /* INPUT_OBJECT level directives (e.g. @oneOf), run after all fields
	       have been unmarshaled. Mirrors codegen/input.gotpl. */}}
	directive0 := func(ctx context.Context) (any, error) { return {{ $it }}, nil }
	{{- range $i, $directive := $input.InputObjectDirectives }}
	directive{{ add $i 1 }} := func(ctx context.Context) (any, error) {
		return ec.InvokeDirective(ctx, {{ $directive.Name | quote }}, asMap, directive{{ $i }}, {{ template "splitDirectiveArgs" $directive }})
	}
	{{- end }}
	tmp, err := directive{{ len $input.InputObjectDirectives }}(ctx)
	if err != nil {
		return {{ $it }}, graphql.ErrorOnPath(ctx, err)
	}
	if data, ok := tmp.({{ if $input.PointersInUnmarshalInput }}*{{ end }}{{ $input.Type | ref }}); ok {
		return data, nil
	}
	return {{ $it }}, graphql.ErrorOnPath(ctx, fmt.Errorf(`unexpected type %T from INPUT_OBJECT directive, should be {{ if $input.PointersInUnmarshalInput }}*{{ end }}{{ $input.Type | ref }}`, tmp))
	{{- else }}

	return {{ $it }}, nil
	{{- end }}
}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{ end }}
